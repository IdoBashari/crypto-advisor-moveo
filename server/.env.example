# Session pooler connection string (Supabase dashboard > Connect)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Direct connection string. If the direct host is IPv6-only and unreachable from
# your machine, use the session pooler string here as well.
DIRECT_URL=postgresql://user:password@host:5432/postgres
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Signing secret for auth tokens. Use a long random hex string, unique per
# environment. Placeholder only, never commit a real secret.
JWT_SECRET=replace-with-a-long-random-hex-string
JWT_EXPIRES_IN=24h

# CoinGecko demo-plan API key (coingecko.com > Developer Dashboard). Sent as the
# x-cg-demo-api-key header against api.coingecko.com; a pro-plan key targets a
# different host and will not work here. Placeholder only, never commit a real key.
COINGECKO_API_KEY=replace-with-a-coingecko-demo-api-key

# Canned insights, no LLM request. Defaults to true outside production and
# false in production, so leaving this unset is the right choice locally.
MOCK_LLM=true

# OpenRouter API key, required only when MOCK_LLM is false — which is why the
# app runs from a fresh clone without an OpenRouter account. The free tier
# allows 50 requests per day across the whole account. Placeholder only, never
# commit a real key.
OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
